class Cor:
    def __init__(self, ativo: bool):
        self.a = ativo

    def __call__(self, cod, txt):
        return f"\033[{cod}m{txt}\033[0m" if self.a else str(txt)


def imprimir(r: dict, ant: dict | None, cor: Cor):
    s = resumo(r)
    c = r["conexao"]
    print()
    print(cor("1;34", "  KURUMIN PULSO") + cor("2", f"  v{VERSAO} · Kurumin Tecnologia"))
    print(cor("2", "  " + "─" * 52))
    tipo = {"wifi": "Wi-Fi", "cabo": "Cabo", "usb": "USB/celular"}.get(c.get("tipo"), "desconhecida")
    det = ""
    if c.get("tipo") == "wifi":
        det = f"{c.get('wifi_banda', '?')}, sinal {c.get('wifi_sinal_dbm', '?')} dBm, taxa {c.get('wifi_taxa_mbps', '?')} Mb/s"
    elif c.get("cabo_link_mbps"):
        det = f"link {c['cabo_link_mbps']} Mb/s {c.get('cabo_duplex', '')}"
    print(f"  Conexão   {cor('1', tipo)} ({c.get('interface') or '?'}) {cor('2', det)}")

    def linha(nome, v, un, chave, menor_melhor):
        txt = f"{_fmt(v):>8} {un}"
        if ant and ant.get(chave) is not None and v is not None:
            d = v - ant[chave]
            if abs(d) >= 0.05:
                melhor = (d < 0) if menor_melhor else (d > 0)
                txt += "  " + cor("32" if melhor else "31", f"{'▼' if d < 0 else '▲'}{_fmt(abs(d))}")
        print(f"  {nome:<10}{txt}")

    linha("Latência", s["latencia_ms"], "ms", "latencia_ms", True)
    linha("Jitter", s["jitter_ms"], "ms", "jitter_ms", True)
    linha("Perda", s["perda_pct"], "%", "perda_pct", True)
    linha("DNS", s["dns_ms"], "ms", "dns_ms", True)
    if r.get("download") is not None:
        if "erro" in r["download"]:
            print(f"  {'Download':<10}{cor('31', 'falhou: ' + r['download']['erro'])}")
        else:
            linha("Download", s["download_mbps"], "Mbit/s", "download_mbps", False)
    if r.get("upload") is not None:
        if "erro" in r["upload"]:
            print(f"  {'Upload':<10}{cor('31', 'falhou: ' + r['upload']['erro'])}")
        else:
            linha("Upload", s["upload_mbps"], "Mbit/s", "upload_mbps", False)
    gw = r["latencia"].get("gateway")
    if gw:
        print(cor("2", f"  Roteador  {_fmt(gw.get('media'))} ms, perda {_fmt(gw.get('perda_pct'))}% ({gw['metodo']})"))
    print(cor("2", "  " + "─" * 52))
    mapa = {"bom": ("32", "✓"), "alerta": ("33", "!"), "serio": ("33;1", "!"), "critico": ("31;1", "✕")}
    for d in r["diagnostico"]:
        k, ic = mapa[d["nivel"]]
        print(f"  {cor(k, ic)} {cor('1', d['titulo'])}")
        print(cor("2", f"    {d['texto']}"))
    print()



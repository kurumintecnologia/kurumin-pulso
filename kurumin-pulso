def resumo(r: dict) -> dict:
    """Números-chave de um teste, usados no histórico e nas comparações."""
    inet = [p for p in r["latencia"]["internet"] if p.get("media") is not None]
    todos = r["latencia"]["internet"]
    return {
        "quando": r["quando"],
        "rotulo": r.get("rotulo"),
        "tipo": r["conexao"].get("tipo"),
        "latencia_ms": arred(statistics.fmean(p["media"] for p in inet), 1) if inet else None,
        "jitter_ms": arred(statistics.fmean(p["jitter"] for p in inet), 1) if inet else None,
        "perda_pct": arred(statistics.fmean(p["perda_pct"] for p in todos), 1) if todos else None,
        "dns_ms": r["dns"].get("media_ms"),
        "download_mbps": (r.get("download") or {}).get("mbps"),
        "upload_mbps": (r.get("upload") or {}).get("mbps"),
        "wifi_sinal_dbm": r["conexao"].get("wifi_sinal_dbm"),
    }


def diagnosticar(r: dict, contratado: tuple[float, float] | None) -> list[dict]:
    d = []

    def add(nivel, titulo, texto):
        d.append({"nivel": nivel, "titulo": titulo, "texto": texto})

    s = resumo(r)
    gw = r["latencia"].get("gateway") or {}
    perda_gw = gw.get("perda_pct")
    perda = s["perda_pct"]

    if perda is None:
        add("critico", "Sem resposta da internet", "Nenhum destino respondeu. Verifique cabo, Wi-Fi e roteador.")
    elif perda > 0:
        if perda_gw and perda_gw > 0:
            add("critico" if perda >= 2 else "alerta", f"Perda de pacotes: {_fmt(perda)}%",
                f"A perda já começa dentro de casa (roteador: {_fmt(perda_gw)}%). Suspeite do cabo, da porta ou do Wi-Fi.")
        else:
            add("critico" if perda >= 2 else "alerta", f"Perda de pacotes: {_fmt(perda)}%",
                "A rede de casa está limpa e a perda aparece depois do roteador: indício de problema no provedor.")
    else:
        add("bom", "Sem perda de pacotes", "Todos os pacotes de teste foram e voltaram.")

    if s["jitter_ms"] is not None:
        j = s["jitter_ms"]
        if j > 30:
            add("serio", f"Jitter alto: {_fmt(j)} ms", "Chamadas de vídeo e jogos vão travar. Comum em Wi-Fi fraco ou rede congestionada.")
        elif j > 10:
            add("alerta", f"Jitter moderado: {_fmt(j)} ms", "Funciona, mas a conexão oscila. No cabo costuma ficar abaixo de 5 ms.")
        else:
            add("bom", f"Jitter baixo: {_fmt(j)} ms", "Latência estável.")

    if s["latencia_ms"] is not None and s["latencia_ms"] > 80:
        add("serio" if s["latencia_ms"] > 150 else "alerta", f"Latência alta: {_fmt(s['latencia_ms'])} ms",
            "Resposta lenta até a internet. Compare com outros horários.")

    c = r["conexao"]
    if c.get("tipo") == "wifi" and (sinal := c.get("wifi_sinal_dbm")) is not None:
        if sinal < -70:
            add("serio", f"Sinal Wi-Fi fraco: {sinal} dBm", "Aproxime o computador do roteador ou use cabo.")
        elif sinal < -60:
            add("alerta", f"Sinal Wi-Fi aceitável: {sinal} dBm", "Funciona, mas está perto do limite. Abaixo de -70 dBm começam as quedas.")
        else:
            add("bom", f"Sinal Wi-Fi bom: {sinal} dBm", "Sinal forte.")
    if c.get("tipo") == "cabo" and (lk := c.get("cabo_link_mbps")):
        if lk < 1000:
            add("alerta", f"Cabo negociou só {lk} Mb/s", "Placa e roteador gigabit deveriam fechar 1000 Mb/s. Cabo danificado ou porta ruim limitam a velocidade.")
        if (c.get("cabo_duplex") or "").lower() == "half":
            add("serio", "Cabo em half-duplex", "Sinal clássico de cabo ou conector com defeito.")

    if contratado:
        for chave, cont, nome in (("download_mbps", contratado[0], "Download"), ("upload_mbps", contratado[1], "Upload")):
            v = s.get(chave)
            if v is None or not cont:
                continue
            pct = 100 * v / cont
            if pct < 40:
                add("critico", f"{nome} a {pct:.0f}% do contratado",
                    f"{_fmt(v)} de {_fmt(cont)} Mbit/s: abaixo do piso de 40% da velocidade instantânea (referência Anatel). Repita em outros horários e registre.")
            elif pct < 80:
                add("alerta", f"{nome} a {pct:.0f}% do contratado",
                    f"{_fmt(v)} de {_fmt(cont)} Mbit/s. A média do mês deve ficar em pelo menos 80% (referência Anatel).")
            else:
                add("bom", f"{nome} a {pct:.0f}% do contratado", f"{_fmt(v)} de {_fmt(cont)} Mbit/s.")
    ordem = {"critico": 0, "serio": 1, "alerta": 2, "bom": 3}
    return sorted(d, key=lambda x: ordem[x["nivel"]])



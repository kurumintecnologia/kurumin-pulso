def _teto(v: float) -> float:
    if v <= 0:
        return 1
    e = 10 ** math.floor(math.log10(v))
    for m in (1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10):
        if v <= m * e:
            return m * e
    return 10 * e


def _fmt(v, casas=1):
    if v is None:
        return "—"
    return f"{v:,.{casas}f}".replace(",", "X").replace(".", ",").replace("X", ".")


def svg_linhas(series, xrot, unidade, ref=None, alt=240, larg=900):
    """series: [(nome, var_css, [valores ou None])]. Um eixo só, uma unidade só."""
    me, md, mt, mb = 48, 110, 14, 30
    vals = [v for _, _, vs in series for v in vs if v is not None]
    if ref:
        vals.append(ref[0])
    if not vals:
        return '<p class="sub">Sem dados para o gráfico.</p>'
    ymax = _teto(max(vals) * 1.1 / 4) * 4
    n = max(len(vs) for _, _, vs in series)
    w, h = larg - me - md, alt - mt - mb
    X = lambda i: me + (w * i / (n - 1) if n > 1 else w / 2)
    Y = lambda v: mt + h - h * v / ymax
    o = [f'<svg viewBox="0 0 {larg} {alt}" width="100%" role="img" aria-label="Gráfico em {unidade}">']
    for k in range(5):
        v = ymax * k / 4
        o.append(f'<line x1="{me}" x2="{me + w}" y1="{Y(v):.1f}" y2="{Y(v):.1f}" stroke="var(--grid)" stroke-width="1"/>'
                 f'<text x="{me - 8}" y="{Y(v) + 4:.1f}" text-anchor="end">{_fmt(v, 0 if ymax >= 8 else 1)}</text>')
    o.append(f'<text x="{me}" y="{mt - 2}" font-size="11">{html.escape(unidade)}</text>')
    passo = max(1, math.ceil(n / 8))
    for i in range(0, n, passo):
        if i < len(xrot):
            anc = "start" if (i == 0 and n > 1) else ("end" if (i == n - 1 and n > 1) else "middle")
            o.append(f'<text x="{X(i):.1f}" y="{alt - 8}" text-anchor="{anc}">{html.escape(xrot[i])}</text>')
    if ref:
        o.append(f'<line x1="{me}" x2="{me + w}" y1="{Y(ref[0]):.1f}" y2="{Y(ref[0]):.1f}" stroke="var(--ref)" stroke-width="1.5" stroke-dasharray="5 4"/>'
                 f'<text x="{me + w + 6}" y="{Y(ref[0]) + 4:.1f}">{html.escape(ref[1])}</text>')
    rotulos = []
    for nome, cor, vs in series:
        seg, segs = [], []
        for i, v in enumerate(vs):
            if v is None:
                if seg:
                    segs.append(seg)
                seg = []
            else:
                seg.append((X(i), Y(v)))
        if seg:
            segs.append(seg)
        for s in segs:
            pts = " ".join(f"{x:.1f},{y:.1f}" for x, y in s)
            o.append(f'<polyline points="{pts}" fill="none" stroke="var({cor})" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>')
        mostrar_pontos = n <= 40
        for i, v in enumerate(vs):
            if v is None:
                continue
            dica = html.escape(f"{nome} · {xrot[i] if i < len(xrot) else i + 1}: {_fmt(v)} {unidade}")
            if mostrar_pontos:
                o.append(f'<circle cx="{X(i):.1f}" cy="{Y(v):.1f}" r="4" fill="var({cor})" stroke="var(--surface-1)" stroke-width="2"/>')
            o.append(f'<circle cx="{X(i):.1f}" cy="{Y(v):.1f}" r="11" fill="transparent" data-tip="{dica}"/>')
        ult = [(i, v) for i, v in enumerate(vs) if v is not None]
        if ult and len(series) <= 4:
            i, v = ult[-1]
            rotulos.append([Y(v) + 4, X(i) + 10, f"{nome} {_fmt(v)}"])
    # rótulos diretos no fim das linhas, afastados para não se sobreporem
    rotulos.sort()
    for k in range(1, len(rotulos)):
        if rotulos[k][0] - rotulos[k - 1][0] < 15:
            rotulos[k][0] = rotulos[k - 1][0] + 15
    for y, x, t in rotulos:
        o.append(f'<text class="lbl" x="{x:.1f}" y="{y:.1f}">{html.escape(t)}</text>')
    o.append("</svg>")
    return "".join(o)


def svg_barras(grupos, series, unidade, refs=(), alt=250, larg=900):
    """Barras agrupadas: grupos = rótulos do eixo x; series = [(nome, var_css, valores)]."""
    me, md, mt, mb = 48, 110, 14, 30
    vals = [v for _, _, vs in series for v in vs if v is not None] + [r[0] for r in refs]
    if not vals:
        return '<p class="sub">Sem medições de velocidade ainda. Rode sem --rapido.</p>'
    ymax = _teto(max(vals) * 1.1 / 4) * 4
    w, h = larg - me - md, alt - mt - mb
    g = len(grupos)
    larg_g = w / max(g, 1)
    bw = min(28, (larg_g - 10) / len(series) - 2)
    Y = lambda v: mt + h - h * v / ymax
    o = [f'<svg viewBox="0 0 {larg} {alt}" width="100%" role="img" aria-label="Gráfico em {unidade}">']
    for k in range(5):
        v = ymax * k / 4
        o.append(f'<line x1="{me}" x2="{me + w}" y1="{Y(v):.1f}" y2="{Y(v):.1f}" stroke="var(--grid)"/>'
                 f'<text x="{me - 8}" y="{Y(v) + 4:.1f}" text-anchor="end">{_fmt(v, 0 if ymax >= 8 else 1)}</text>')
    o.append(f'<text x="{me}" y="{mt - 2}" font-size="11">{html.escape(unidade)}</text>')
    passo = max(1, math.ceil(g / 8))
    for gi, rot in enumerate(grupos):
        cx = me + larg_g * gi + larg_g / 2
        if gi % passo == 0:
            o.append(f'<text x="{cx:.1f}" y="{alt - 8}" text-anchor="middle">{html.escape(rot)}</text>')
        x0 = cx - (len(series) * (bw + 2) - 2) / 2
        for si, (nome, cor, vs) in enumerate(series):
            v = vs[gi] if gi < len(vs) else None
            if v is None:
                continue
            x, y = x0 + si * (bw + 2), Y(v)
            hh = mt + h - y
            r = min(4, bw / 2, hh)
            # topo arredondado, base reta apoiada no eixo
            p = (f"M{x:.1f},{mt + h:.1f} V{y + r:.1f} Q{x:.1f},{y:.1f} {x + r:.1f},{y:.1f} "
                 f"H{x + bw - r:.1f} Q{x + bw:.1f},{y:.1f} {x + bw:.1f},{y + r:.1f} V{mt + h:.1f} Z")
            dica = html.escape(f"{nome} · {rot}: {_fmt(v)} {unidade}")
            o.append(f'<path d="{p}" fill="var({cor})" data-tip="{dica}"/>')
    for v, rot in refs:
        o.append(f'<line x1="{me}" x2="{me + w}" y1="{Y(v):.1f}" y2="{Y(v):.1f}" stroke="var(--ref)" stroke-width="1.5" stroke-dasharray="5 4"/>'
                 f'<text x="{me + w + 6}" y="{Y(v) + 4:.1f}">{html.escape(rot)}</text>')
    o.append("</svg>")
    return "".join(o)


def _legenda(series):
    return '<div class="legend">' + "".join(f'<span><i style="background:var({c})"></i>{html.escape(n)}</span>' for n, c in series) + "</div>"


def _rot_curto(quando: str, rotulo: str | None) -> str:
    t = dt.datetime.fromisoformat(quando)
    base = t.strftime("%d/%m %H:%M")
    return f"{base} · {rotulo}" if rotulo else base


def gerar_html(atual: dict, historico: list[dict], contratado) -> str:
    s = resumo(atual)
    hist = [h for h in historico][-30:]
    ant = historico[-2] if len(historico) >= 2 else None
    c = atual["conexao"]

    def delta(chave, menor_melhor):
        if not ant or ant.get(chave) is None or s.get(chave) is None:
            return "primeiro teste" if not ant else "sem comparação"
        d = s[chave] - ant[chave]
        if abs(d) < 0.05:
            return "igual ao anterior"
        melhor = (d < 0) if menor_melhor else (d > 0)
        return f"{'▼' if d < 0 else '▲'} {_fmt(abs(d))} vs anterior ({'melhor' if melhor else 'pior'})"

    tipo_txt = {"wifi": "Wi-Fi", "cabo": "Cabo", "usb": "USB/celular"}.get(c.get("tipo"), "—")
    extra = ""
    if c.get("tipo") == "wifi":
        extra = f"{c.get('wifi_banda', '')} · {c.get('wifi_sinal_dbm', '—')} dBm"
    elif c.get("cabo_link_mbps"):
        extra = f"link {c['cabo_link_mbps']} Mb/s · {c.get('cabo_duplex', '')}"

    tiles = [
        ("Latência", _fmt(s["latencia_ms"]), "ms", delta("latencia_ms", True)),
        ("Jitter", _fmt(s["jitter_ms"]), "ms", delta("jitter_ms", True)),
        ("Perda", _fmt(s["perda_pct"]), "%", delta("perda_pct", True)),
        ("Download", _fmt(s["download_mbps"]), "Mbit/s", delta("download_mbps", False)),
        ("Upload", _fmt(s["upload_mbps"]), "Mbit/s", delta("upload_mbps", False)),
        ("Conexão", tipo_txt, "", extra or c.get("interface") or ""),
    ]
    tiles_html = "".join(
        f'<div class="tile"><div class="rot">{r}</div><div class="val">{v}<small>{u}</small></div><div class="delta">{html.escape(dl)}</div></div>'
        for r, v, u, dl in tiles)

    diag_html = "".join(
        f'<div class="d" style="--c:var(--{NIVEIS[x["nivel"]][0]})"><div class="ico" aria-hidden="true">{NIVEIS[x["nivel"]][1]}</div>'
        f'<div><b>{NIVEIS[x["nivel"]][2]}: {html.escape(x["titulo"])}</b><span>{html.escape(x["texto"])}</span></div></div>'
        for x in atual["diagnostico"])

    # gráfico 1: cada pacote do teste atual
    cores = ["--series-1", "--series-2", "--series-3"]
    linhas_teste = []
    gw = atual["latencia"].get("gateway")
    if gw and gw.get("amostras"):
        linhas_teste.append(("Roteador", gw["amostras"]))
    for nome, p in zip([a for a, _ in ALVOS_INTERNET], atual["latencia"]["internet"]):
        if p.get("amostras"):
            linhas_teste.append((nome, p["amostras"]))
    ser1 = [(n, cores[i], v) for i, (n, v) in enumerate(linhas_teste[:3])]
    n1 = max((len(v) for _, _, v in ser1), default=0)
    g1 = svg_linhas(ser1, [str(i + 1) for i in range(n1)], "ms") if ser1 else '<p class="sub">Sem amostras.</p>'

    # gráfico 2: histórico de latência e jitter (mesma unidade, um eixo)
    xr = [_rot_curto(h["quando"], h.get("rotulo")) for h in hist]
    ser2 = [("Latência", "--series-1", [h.get("latencia_ms") for h in hist]),
            ("Jitter", "--series-2", [h.get("jitter_ms") for h in hist])]
    g2 = svg_linhas(ser2, xr, "ms")

    # gráfico 3: histórico de velocidade
    ser3 = [("Download", "--series-1", [h.get("download_mbps") for h in hist]),
            ("Upload", "--series-2", [h.get("upload_mbps") for h in hist])]
    refs = []
    if contratado and contratado[0]:
        refs.append((contratado[0] * 0.4, "40% down"))
    g3 = svg_barras(xr, ser3, "Mbit/s", refs)

    linhas_tab = "".join(
        f"<tr><td>{html.escape(_rot_curto(h['quando'], None))}</td><td>{html.escape((h.get('rotulo') or '') + (' (' + h['tipo'] + ')' if h.get('tipo') else ''))}</td>"
        f"<td>{_fmt(h.get('latencia_ms'))}</td><td>{_fmt(h.get('jitter_ms'))}</td><td>{_fmt(h.get('perda_pct'))}</td>"
        f"<td>{_fmt(h.get('dns_ms'))}</td><td>{_fmt(h.get('download_mbps'))}</td><td>{_fmt(h.get('upload_mbps'))}</td>"
        f"<td>{h.get('wifi_sinal_dbm') if h.get('wifi_sinal_dbm') is not None else '—'}</td></tr>"
        for h in reversed(hist))

    sites = atual.get("sites") or []
    sites_html = ""
    if sites:
        sites_html = "<h2>Sites testados</h2><div class='card'><table><tr><th>Endereço</th><th></th><th>Status</th><th>1º byte (ms)</th><th>Total (ms)</th></tr>" + "".join(
            f"<tr><td>{html.escape(x['url'])}</td><td></td><td>{x.get('status', html.escape(x.get('erro', '—')))}</td>"
            f"<td>{x.get('primeiro_byte_ms', '—')}</td><td>{x.get('total_ms', '—')}</td></tr>" for x in sites) + "</table></div>"

    quando = dt.datetime.fromisoformat(atual["quando"]).strftime("%d/%m/%Y às %H:%M")
    rot = f" · {html.escape(atual['rotulo'])}" if atual.get("rotulo") else ""
    return f"""<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kurumin Pulso · {quando}</title><style>{CSS}</style></head>
<body><div class="viz-root"><div class="wrap">
<header><div><div class="marca">Kurumin Tecnologia</div><h1>Kurumin <span>Pulso</span></h1></div>
<div class="meta">Teste de {quando}{rot}<br>{len(historico)} teste(s) no histórico · v{VERSAO}</div></header>

<div class="tiles">{tiles_html}</div>

<h2>Diagnóstico</h2><p class="sub">O que os números querem dizer, do mais importante para o menos.</p>
<div class="diag">{diag_html}</div>

<h2>Latência de cada pacote neste teste</h2>
<p class="sub">Linha reta e baixa é conexão estável. Picos indicam oscilação; buracos na linha são pacotes perdidos.</p>
<div class="card">{_legenda([(n, c) for n, c, _ in ser1])}{g1}</div>

<h2>Histórico: latência e jitter</h2><p class="sub">Últimos {len(hist)} testes neste computador. Quanto mais baixo, melhor.</p>
<div class="card">{_legenda([(n, c) for n, c, _ in ser2])}{g2}</div>

<h2>Histórico: velocidade</h2><p class="sub">Download e upload medidos contra a rede do Cloudflare.{' A linha tracejada é 40% do contratado.' if refs else ''}</p>
<div class="card">{_legenda([(n, c) for n, c, _ in ser3])}{g3}
<details><summary>Ver todos os testes em tabela</summary>
<table><tr><th>Quando</th><th>Rótulo</th><th>Latência ms</th><th>Jitter ms</th><th>Perda %</th><th>DNS ms</th><th>Down Mbit/s</th><th>Up Mbit/s</th><th>Sinal dBm</th></tr>{linhas_tab}</table>
</details></div>
{sites_html}
<footer>Medição indicativa feita a partir deste computador; não substitui a medição oficial da Anatel.
Latência por ICMP (ping) ou, sem ping, pelo tempo de conexão TCP. Velocidade medida em speed.cloudflare.com.
Nenhum IP é gravado no relatório sem a opção <code>--detalhes</code>.<br>
Kurumin Pulso é software livre (GPL-3.0-or-later) · <a href="{REPO}">{REPO.replace('https://', '')}</a> · Kurumin Tecnologia · contato@kurumintecnologia.com.br</footer>
</div></div><div id="tip" role="tooltip"></div><script>{JS}</script></body></html>"""



def ler_historico(caminho: str) -> list[dict]:
    hist = []
    try:
        with open(caminho, encoding="utf-8") as f:
            for linha in f:
                linha = linha.strip()
                if linha:
                    try:
                        hist.append(json.loads(linha))
                    except json.JSONDecodeError:
                        pass
    except OSError:
        pass
    return hist


def parse_contratado(txt: str | None):
    if not txt:
        return None
    m = re.fullmatch(r"\s*([\d.,]+)\s*(?:/\s*([\d.,]+))?\s*", txt)
    if not m:
        raise argparse.ArgumentTypeError("use o formato DOWN/UP em Mbit/s, ex.: 300/150")
    down = float(m.group(1).replace(",", "."))
    up = float(m.group(2).replace(",", ".")) if m.group(2) else None
    return (down, up)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="kurumin-pulso",
        description="Kurumin Pulso: teste de rede em um comando, com relatório e histórico. Software livre (GPL-3.0).")
    ap.add_argument("--rotulo", help="nome curto para este teste (ex.: cabo, wifi, 4g, escritorio)")
    ap.add_argument("--contratado", type=parse_contratado, help="velocidade do plano em Mbit/s, DOWN/UP (ex.: 300/150)")
    ap.add_argument("--rapido", action="store_true", help="pula o teste de velocidade (só latência, perda e DNS)")
    ap.add_argument("--pacotes", type=int, default=30, help="pacotes por destino (padrão: 30)")
    ap.add_argument("--mb-down", type=int, default=25, help="tamanho do download em MB (padrão: 25)")
    ap.add_argument("--mb-up", type=int, default=10, help="tamanho do upload em MB (padrão: 10)")
    ap.add_argument("--site", action="append", default=[], metavar="URL", help="mede o tempo de resposta de um site (pode repetir)")
    ap.add_argument("--saida", help="pasta dos relatórios (padrão: ~/.local/share/kurumin-pulso/relatorios)")
    ap.add_argument("--detalhes", action="store_true", help="grava IPs do roteador no histórico e no relatório")
    ap.add_argument("--json", action="store_true", help="imprime o resultado em JSON (para scripts e painéis)")
    ap.add_argument("--sem-html", action="store_true", help="não gera o relatório HTML")
    ap.add_argument("--version", action="version", version=f"kurumin-pulso {VERSAO}")
    a = ap.parse_args(argv)

    cor = Cor(sys.stdout.isatty() and not a.json and os.environ.get("NO_COLOR") is None)
    log = (lambda m: None) if a.json else (lambda m: print(cor("2", f"  · {m}"), flush=True))

    agora = dt.datetime.now().astimezone().replace(microsecond=0)
    r: dict = {"versao": VERSAO, "quando": agora.isoformat(), "rotulo": a.rotulo}

    log("identificando a conexão")
    r["conexao"] = conexao(a.detalhes)
    gw_ip = r["conexao"].pop("_gateway", None)

    r["latencia"] = {"gateway": None, "internet": []}
    if gw_ip:
        log("medindo até o roteador")
        r["latencia"]["gateway"] = medir_latencia(gw_ip, a.pacotes, porta_tcp=53)
    for nome, ip in ALVOS_INTERNET:
        log(f"medindo até {nome}")
        p = medir_latencia(ip, a.pacotes)
        p["destino"] = nome
        r["latencia"]["internet"].append(p)

    log("medindo DNS")
    r["dns"] = medir_dns()

    if not a.rapido:
        log(f"baixando {a.mb_down} MB")
        r["download"] = medir_download(a.mb_down)
        log(f"enviando {a.mb_up} MB")
        r["upload"] = medir_upload(a.mb_up)
    r["sites"] = [medir_site(u) for u in a.site]
    r["diagnostico"] = diagnosticar(r, a.contratado)

    dados = pasta_dados()
    arq_hist = os.path.join(dados, "historico.jsonl")
    hist = ler_historico(arq_hist)
    ant = hist[-1] if hist else None
    s = resumo(r)
    with open(arq_hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(s, ensure_ascii=False) + "\n")
    hist.append(s)
    with open(os.path.join(dados, "ultimo.json"), "w", encoding="utf-8") as f:
        json.dump(r, f, ensure_ascii=False, indent=2)

    caminho_html = None
    if not a.sem_html:
        pasta = a.saida or os.path.join(dados, "relatorios")
        os.makedirs(pasta, exist_ok=True)
        caminho_html = os.path.join(pasta, f"pulso-{agora.strftime('%Y%m%d-%H%M%S')}.html")
        conteudo = gerar_html(r, hist, a.contratado)
        with open(caminho_html, "w", encoding="utf-8") as f:
            f.write(conteudo)
        with open(os.path.join(pasta, "ultimo.html"), "w", encoding="utf-8") as f:
            f.write(conteudo)

    if a.json:
        print(json.dumps(r, ensure_ascii=False, indent=2))
    else:
        imprimir(r, ant, cor)
        if caminho_html:
            print(f"  Relatório: {cor('4', 'file://' + caminho_html)}")
        print(cor("2", f"  Histórico: {arq_hist} ({len(hist)} teste(s))"))
        print()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n  interrompido.")
        sys.exit(130)

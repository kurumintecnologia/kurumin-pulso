def conexao(detalhes: bool) -> dict:
    """Descobre por onde o computador sai para a internet (cabo, Wi-Fi, USB)."""
    info: dict = {"interface": None, "tipo": "desconhecido"}
    rota = executar(["ip", "route", "show", "default"])
    m = re.search(r"default via (\S+) dev (\S+)", rota)
    if not m:
        return info
    gw, dev = m.group(1), m.group(2)
    info["interface"] = dev
    info["_gateway"] = gw  # usado no teste; só vai para o relatório com --detalhes
    if detalhes:
        info["gateway"] = gw

    if os.path.isdir(f"/sys/class/net/{dev}/wireless") or dev.startswith("wl"):
        info["tipo"] = "wifi"
        saida = executar(["iw", "dev", dev, "link"])
        if (f := re.search(r"freq:\s*([\d.]+)", saida)):
            mhz = float(f.group(1))
            info["wifi_freq_mhz"] = mhz
            info["wifi_banda"] = "6 GHz" if mhz >= 5925 else ("5 GHz" if mhz >= 4900 else "2,4 GHz")
        if (s := re.search(r"signal:\s*(-?\d+)", saida)):
            info["wifi_sinal_dbm"] = int(s.group(1))
        if (b := re.search(r"tx bitrate:\s*([\d.]+)", saida)):
            info["wifi_taxa_mbps"] = float(b.group(1))
        if "wifi_sinal_dbm" not in info:  # sem o iw: tenta o /proc
            for linha in (ler("/proc/net/wireless") or "").splitlines():
                if linha.strip().startswith(dev + ":"):
                    partes = linha.split()
                    try:
                        info["wifi_sinal_dbm"] = int(float(partes[3]))
                    except (IndexError, ValueError):
                        pass
    elif dev.startswith(("usb", "rndis", "enx")) and os.path.exists(f"/sys/class/net/{dev}/device"):
        info["tipo"] = "usb"
    else:
        info["tipo"] = "cabo"
        vel = ler(f"/sys/class/net/{dev}/speed")
        dup = ler(f"/sys/class/net/{dev}/duplex")
        if vel and vel.lstrip("-").isdigit() and int(vel) > 0:
            info["cabo_link_mbps"] = int(vel)
        if dup:
            info["cabo_duplex"] = dup
    return info


def _resumo_amostras(amostras: list[float], enviados: int, recebidos: int, metodo: str) -> dict:
    r = {
        "metodo": metodo,
        "enviados": enviados,
        "recebidos": recebidos,
        "perda_pct": arred(100 * (enviados - recebidos) / enviados if enviados else 100.0),
        "amostras": [round(a, 2) for a in amostras],
    }
    if amostras:
        r["min"] = arred(min(amostras), 2)
        r["media"] = arred(statistics.fmean(amostras), 2)
        r["max"] = arred(max(amostras), 2)
        r["desvio"] = arred(statistics.pstdev(amostras), 2)  # equivale ao "mdev" do ping
        difs = [abs(b - a) for a, b in zip(amostras, amostras[1:])]
        r["jitter"] = arred(statistics.fmean(difs), 2) if difs else 0.0
    return r


def medir_latencia(host: str, n: int, porta_tcp: int = 443) -> dict:
    """Usa o ping (ICMP). Sem ping disponível, mede o tempo de conexão TCP."""
    if shutil.which("ping"):
        saida = executar(["ping", "-n", "-c", str(n), "-i", "0.2", "-W", "2", host], timeout=n * 0.3 + 15)
        if (m := re.search(r"(\d+) packets transmitted, (\d+) (?:packets )?received", saida)):
            amostras = [float(x) for x in re.findall(r"time[=<]([\d.]+)", saida)]
            return _resumo_amostras(amostras, int(m.group(1)), int(m.group(2)), "icmp")
    amostras = []
    for _ in range(n):
        t0 = time.perf_counter()
        try:
            with socket.create_connection((host, porta_tcp), timeout=2):
                amostras.append((time.perf_counter() - t0) * 1000)
        except OSError:
            pass
        time.sleep(0.2)
    return _resumo_amostras(amostras, n, len(amostras), f"tcp:{porta_tcp}")


def medir_dns() -> dict:
    tempos = {}
    for d in DOMINIOS_DNS:
        t0 = time.perf_counter()
        try:
            socket.getaddrinfo(d, 443)
            tempos[d] = round((time.perf_counter() - t0) * 1000, 1)
        except OSError:
            tempos[d] = None
    ok = [v for v in tempos.values() if v is not None]
    return {"tempos_ms": tempos, "media_ms": arred(statistics.fmean(ok)) if ok else None, "falhas": len(tempos) - len(ok)}


def _http(req: urllib.request.Request, timeout: float):
    return urllib.request.urlopen(req, timeout=timeout)


def medir_download(mb: int) -> dict:
    n = mb * 1_000_000
    try:  # aquecimento curto (abre a conexão, não entra na conta)
        with _http(urllib.request.Request(URL_DOWN.format(n=100_000), headers={"User-Agent": UA}), 15) as r:
            r.read()
    except (urllib.error.URLError, OSError):
        pass
    req = urllib.request.Request(URL_DOWN.format(n=n), headers={"User-Agent": UA})
    try:
        t0 = time.perf_counter()
        total = 0
        with _http(req, 60) as r:
            while (bloco := r.read(256 * 1024)):
                total += len(bloco)
        seg = time.perf_counter() - t0
    except (urllib.error.URLError, OSError) as e:
        return {"erro": str(getattr(e, "reason", e))[:120]}
    if total < n * 0.9:
        return {"erro": f"resposta incompleta ({total} de {n} bytes)"}
    return {"mbps": round(total * 8 / seg / 1e6, 1), "bytes": total, "segundos": round(seg, 2)}


def medir_upload(mb: int) -> dict:
    dados = os.urandom(mb * 1_000_000)
    req = urllib.request.Request(URL_UP, data=dados, method="POST",
                                 headers={"User-Agent": UA, "Content-Type": "application/octet-stream"})
    try:
        t0 = time.perf_counter()
        with _http(req, 90) as r:
            r.read()
        seg = time.perf_counter() - t0
    except (urllib.error.URLError, OSError) as e:
        return {"erro": str(getattr(e, "reason", e))[:120]}
    return {"mbps": round(len(dados) * 8 / seg / 1e6, 1), "bytes": len(dados), "segundos": round(seg, 2)}


def medir_site(url: str) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    t0 = time.perf_counter()
    try:
        with _http(req, 20) as r:
            r.read(1)
            ttfb = time.perf_counter() - t0
            r.read()
            return {"url": url, "status": r.status, "primeiro_byte_ms": round(ttfb * 1000),
                    "total_ms": round((time.perf_counter() - t0) * 1000)}
    except urllib.error.HTTPError as e:
        return {"url": url, "status": e.code, "total_ms": round((time.perf_counter() - t0) * 1000)}
    except (urllib.error.URLError, OSError) as e:
        return {"url": url, "erro": str(getattr(e, "reason", e))[:120]}



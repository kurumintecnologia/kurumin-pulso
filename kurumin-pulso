def executar(cmd: list[str], timeout: float = 30) -> str:
    """Roda um comando e devolve a saída (vazia se falhar). Força saída em inglês
    para o parse não depender do idioma do sistema."""
    if not shutil.which(cmd[0]):
        return ""
    env = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.stdout + r.stderr
    except (subprocess.TimeoutExpired, OSError):
        return ""


def ler(caminho: str) -> str | None:
    try:
        with open(caminho, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return None


def pasta_dados() -> str:
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    p = os.path.join(base, "kurumin-pulso")
    os.makedirs(p, exist_ok=True)
    return p


def arred(v, casas=1):
    return None if v is None else round(v, casas)


